        {
          "filename": "incident-runbook.md",
          "line_start": 17,
          "line_end": 17,
          "quote": "P95 超过一千二百毫秒时标记 latency_tail"
        }
      ]
    },
    {
      "id": "L05",
      "category": "long_document",
      "query": "说明 request_id 脱敏事件返回条数以及 latency_tail 阈值",
      "scope": null,
      "expected": [
        {
          "filename": "incident-runbook.md",
          "line_start": 10,
          "line_end": 10,
          "quote": "默认只返回最近二十条记录"
        },
        {
          "filename": "incident-runbook.md",
          "line_start": 17,
          "line_end": 17,
          "quote": "P95 超过一千二百毫秒时标记 latency_tail"
