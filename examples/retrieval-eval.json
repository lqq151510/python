    {
      "id": "L02",
      "category": "long_document",
      "query": "request_id 查询脱敏事件默认返回最近多少条记录",
      "scope": null,
      "expected": [
        {
          "filename": "incident-runbook.md",
          "line_start": 10,
          "line_end": 10,
          "quote": "查询脱敏事件时固定按 request_id 过滤，默认只返回最近二十条记录。"
        }
      ]
    },
    {
      "id": "L03",
      "category": "long_document",
      "query": "pool_wait 警报的含义和连接池上限",
      "scope": null,
      "expected": [
        {
          "filename": "incident-runbook.md",
          "line_start": 12,
          "line_end": 12,
          "quote": "数据库连接池最多允许八个连接"
        },
        {
          "filename": "incident-runbook.md",
          "line_start": 12,
          "line_end": 12,
          "quote": "pool_wait 警报表示连接池等待超过三秒"
        }
      ]
    },
    {
      "id": "L04",
      "category": "long_document",
      "query": "latency_tail 的 P95 触发阈值是多少",
      "scope": null,
