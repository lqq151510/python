# DevAssist: copy this file to .env and fill in local secrets.
FASTAPI_ENV=development
PROJECT_NAME=DevAssist
FRONTEND_HOST=http://localhost:5173
SECRET_KEY=
FIRST_SUPERUSER=admin@devassist.example.com
FIRST_SUPERUSER_PASSWORD=
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=noreply@devassist.example.com
SMTP_TLS=false
SMTP_PORT=1025
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/app

# Server-side only. Never use a VITE_ prefix for model credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
CHAT_TOTAL_TIMEOUT_SECONDS=30
CHAT_CONNECT_TIMEOUT_SECONDS=5
CHAT_MAX_TOKENS=1024
# Optional model for answers with retrieved sources. Empty falls back to
# DEEPSEEK_MODEL; the API key and DEEPSEEK_BASE_URL are shared.
CHAT_DOCUMENT_MODEL=
# Optional reasoning effort for ordinary document answers only; empty omits
# the parameter. Only set it when the configured provider/model supports it.
# Values: none, minimal, low, medium, high, xhigh, max.
CHAT_DOCUMENT_REASONING_EFFORT=
# Optional Ollama-only duration in seconds for ordinary document answers when
# DEEPSEEK_BASE_URL uses loopback. 0 requests release after completion; empty
# keeps the server default. Interrupted calls or other clients may delay release.
CHAT_DOCUMENT_OLLAMA_KEEP_ALIVE_SECONDS=
# Experimental strict document-answer JSON/evidence validation. Keep disabled
# until the configured model passes answerability and citation qualification.
CHAT_VALIDATE_DOCUMENT_EVIDENCE=false

# Optional code-generation model. Keep every API key in this file only.
# Formats: openai_chat_completions, openai_responses, anthropic_messages,
# gemini_generate_content.
# If all three CODE_API_KEY / CODE_BASE_URL / CODE_MODEL are empty, chat
# completions reuse DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL.
CODE_API_FORMAT=openai_chat_completions
CODE_API_KEY=
CODE_BASE_URL=
CODE_MODEL=
CODE_MAX_OUTPUT_TOKENS=4096
CODE_TIMEOUT_SECONDS=60
# Local Ollama, OpenAI-compatible. Leave CODE_API_KEY empty. The server may
# send a non-secret placeholder to loopback only; do not commit any key.
# From Compose on macOS, point CODE_BASE_URL at host.docker.internal:11434/v1.
# CODE_BASE_URL=http://127.0.0.1:11434/v1
# CODE_MODEL=qwen2.5-coder:7b
# Third-party OpenAI-compatible API. Put the real key only in this local file.
# CODE_BASE_URL=https://example-provider.invalid/v1
# CODE_MODEL=provider-model-name
# Optional. Used only by the server when importing a public GitHub repository.
# Leave empty to use unauthenticated GitHub API limits. Never put this in the frontend.
GITHUB_TOKEN=

# Optional local zebao-rag process (scripts/rag-worker.sh). No frontend token.
RAG_WORKER_ENABLED=false
RAG_WORKER_URL=http://127.0.0.1:8765
RAG_WORKER_TIMEOUT_SECONDS=30
RAG_MIN_SIMILARITY=0.3
RAG_VECTOR_STORE=milvus
RAG_CACHE_ENABLED=false
# 兼容旧配置：新版检索缓存使用 worker 自动生成的协议指纹，此项不影响新版缓存键。
RAG_EMBEDDING_IDENTITY=qwen3-vl-text-v1
REDIS_URL=redis://127.0.0.1:6379/1

# Optional local AIGC video generation (ComfyUI + MiniMax H3 MLX node).
# Only enable it when ComfyUI listens on the loopback port; every job is
# serialised by the built-in worker because one short clip can take minutes.
AIGC_ENABLED=false
AIGC_COMFY_URL=http://127.0.0.1:8188
AIGC_MAX_QUEUE_DEPTH=4
AIGC_POLL_INTERVAL_SECONDS=5
AIGC_JOB_TIMEOUT_SECONDS=3600
AIGC_MAX_PROMPT_CHARS=2000
# Optional override; default reads the existing .local/mysql.env (never logged).
MYSQL_DATABASE_URL=
